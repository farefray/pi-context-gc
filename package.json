{
  "name": "@farefray/pi-context-gc",
  "version": "0.1.1-farefray.1",
  "type": "module",
  "description": "Semantic compaction scheduler for Pi; exact unbundled SDK 1.3.0 candidate, with a separately installed backend.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-gc",
    "compaction",
    "openai",
    "codex",
    "agent"
  ],
  "files": [
    "index.ts",
    "scheduler-only.ts",
    "src",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "PATCHES.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "typebox": "1.3.27"
  },
  "exports": {
    ".": "./index.ts",
    "./scheduler-only": "./scheduler-only.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "Manuel Cecchetto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farefray/pi-context-gc.git"
  },
  "homepage": "https://github.com/farefray/pi-context-gc#readme",
  "bugs": {
    "url": "https://github.com/farefray/pi-context-gc/issues"
  }
}
